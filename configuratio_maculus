#!/usr/bin/env bash

###############################################################################
# ERROR: Let the user know if the script fails
###############################################################################

trap 'ret=$?; test $ret -ne 0 && printf "\n   \e[31m\033[0m  Wizardry failed\e[31m\033[0m\n" >&2; exit $ret' EXIT

set -e

###############################################################################
# CHECK FOR FUNCTIONS: Check for required functions file
###############################################################################

cd "$(dirname "${BASH_SOURCE[0]}")"

if [ -e functions ]; then
  . "functions"
else
  printf "\n ⚠️  ./functions not found\n"
  exit 1
fi

###############################################################################
# Welcome Message          http://patorjk.com/software/taag/ ( font: Script )
###############################################################################

printf "
