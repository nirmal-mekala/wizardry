###############################################################################
# CHECK: Internet
###############################################################################
chapter "Checking internet connection…"
check_internet_connection

###############################################################################
# PROMPT: Password
###############################################################################
chapter "Caching password…"
ask_for_sudo

###############################################################################
# PROMPT: SSH Key
###############################################################################
chapter 'Checking for SSH key…'
ssh_key_setup

###############################################################################
# INSTALL: Dependencies
###############################################################################
chapter "Installing Dependencies…"

# -----------------------------------------------------------------------------
# XCode
# -----------------------------------------------------------------------------
if type xcode-select >/dev/null 2>&1 && xpath=$( xcode-select --print-path ) &&
  test -d "${xpath}" && test -x "${xpath}" ; then
  print_success_muted "Xcode already installed. Skipping."
else
  step "Installing Xcode…"
  xcode-select --install
  read -p "   ✦  Press enter to continue…"
  print_success "Xcode installed!"
fi

if [ ! -d "$HOME/.bin/" ]; then
  mkdir "$HOME/.bin"
fi

# -----------------------------------------------------------------------------
# Homebrew
# -----------------------------------------------------------------------------
if ! [ -x "$(command -v brew)" ]; then
  step "Installing Homebrew…"
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

  case $(uname -m) in
    'arm64')
      homebrew_path='/opt/homebrew'
      ;;
    'x86_64')
      homebrew_path='/usr/local'
      ;;
    *)
      echo 'An error occurred parsing system architecture'
      ;;
  esac

  # NOTE this code has not been tested thoroughly, but it intends to paramaterize
  # the homebrew path so as to enable dynamic installation on either arm or x86 systems

  (echo; echo "eval \"\$(${homebrew_path}/bin/brew shellenv)\"") >> $HOME/.zprofile
  # eval "\$(${homebrew_path}/bin/brew shellenv)"
  source $HOME/.zprofile

  print_success "Homebrew installed!"
else
  print_success_muted "Homebrew already installed. Skipping."
fi

if brew list | grep -Fq brew-cask; then
  step "Uninstalling old Homebrew-Cask…"
  brew uninstall --force brew-cask
  print_success "Homebrew-Cask uninstalled!"
fi

###############################################################################
# UPDATE: Homebrew
###############################################################################
chapter "Updating Homebrew…"
brew update

###############################################################################
# INSTALL: Homebrew packages (Brewfile)
###############################################################################
if [ -e "$cwd/Brewfile" ]; then
  if ask "Do you want to install Homebrew packages from the Brewfile?" Y; then
    chapter "Installing Homebrew packages…"
    brew bundle --file="$cwd/Brewfile"
  else
    print_success_muted "Declined to install Homebrew packages. Skipped."
  fi
fi

###############################################################################
# CLEAN: Homebrew files
###############################################################################
chapter "Cleaning up Homebrew files…"
brew cleanup 2> /dev/null

###############################################################################
# SETUP: Dotfiles
###############################################################################
chapter "Setting up dotfiles…"
if ask "Do you want to set up dotfiles right now?" Y; then
  if [ ! -e "$HOME/.dotfiles" ]; then
    echo_install "Cloning dotfiles to $HOME/.dotfiles"
    git clone https://github.com/nirmal-mekala/dotfiles "$HOME/.dotfiles"
  fi
  bash "$HOME/.dotfiles/setup_dotfiles"
else
  print_success_muted "Declined to set up dotfiles. Skipped."
fi

###############################################################################
# SETUP: macOS defaults
###############################################################################
chapter "Setting up macOS defaults…"
if [ -e "$cwd/macos" ]; then
  if ask "Do you want to set up macOS defaults?" Y; then
    bash "$cwd/macos"
  else
    print_success_muted "Declined to set up macOS defaults. Skipped."
  fi
else
  print_warning "No macOS setup script found! Skipping."
fi

###############################################################################
# NOTIFY COMPLETED
###############################################################################
completed
